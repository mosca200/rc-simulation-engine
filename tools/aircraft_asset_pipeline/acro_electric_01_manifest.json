  "purpose": "presentation_only",
  "consumed_by_simulation": false,
  "notes": [
    "This manifest is PRESENTATION ONLY. Nothing here is read by the simulation, physics,",
    "aerodynamics, propulsion, servo, mixer, contact, scheduler, replay or fingerprint code.",
    "The runtime articulation authority remains models/acro_electric_01/model.json under",
    "'presentation.articulated_surfaces', resolved by explicit primitive index and binding id.",
    "Blender object names exist for the asset pipeline; they never drive runtime inference."
  ],

  "coordinate_system": {
    "runtime_frame": "render-body",
    "handedness": "right",
    "axes": {
      "plus_x": "aircraft right",
      "plus_y": "up",
      "minus_z": "forward / nose"
    },
    "gltf_convention": "+Y up, -Z forward (glTF 2.0 right-handed)",
    "blender_convention": "+Z up, -Y forward, +X right",
    "render_body_to_blender": [1, 0, 0, 0, 0, -1, 0, 1, 0],
    "render_body_to_blender_note": "blender = (x, -z, y) for a render-body point (x, y, z)"
  },

  "units": {
    "linear": "metre",
    "blender_unit_system": "METRIC",
    "blender_scale_length": 1.0,
    "blender_length_unit": "METERS",
    "angle": "radian"
  },

