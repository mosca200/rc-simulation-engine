    "runtime_binding_source": "models/acro_electric_01/model.json -> presentation.articulated_surfaces",
    "no_name_based_runtime_inference": true,
    "pivot_purpose": "DCC authoring and preview only; the runtime never reads Blender origins",
    "hinge_axis_note": [
      "The aileron hinge axes are deliberately not unit length: [1.0, +/-0.054, 0.0] encodes the",
      "wing dihedral so the deflected aileron follows the wing plane. renderer::SurfaceHinge::new",
      "requires only finite components and |axis| > 1e-9 and normalizes internally, so the authored",
      "vector is preserved verbatim in model.json and mirrored here. hinge_axis_normalized_render_body",
      "records what the runtime actually rotates about; validate_glb.py checks both."
    ]
  },

