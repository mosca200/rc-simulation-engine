  "semantic_naming": {
    "object_name_pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$",
    "export_node_name_pattern": "^([0-9]{2})_([A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$",
    "export_order_prefix_note": [
      "Blender 5.2's glTF exporter emits nodes (and therefore mesh indices) in alphabetical",
      "object-name order, not in creation or outliner order. Verified empirically on Blender",
      "5.2.1 LTS / Khronos glTF Blender I/O v5.2.40. Because the runtime maps moving surfaces",
      "by primitive index, export order must be pinned by construction rather than inherited",
      "accidentally. blender_export_glb.py therefore renames each object to",
      "'{primitive_index:02d}_{SEMANTIC_ID}' in a throwaway in-memory session before export.",
      "The .blend source keeps the clean semantic names; the prefix never lands in the source."
    ],
    "families": {
      "structure": "load-bearing airframe parts",
      "control_surface": "articulated moving surface, one object per surface, never merged",
      "propeller": "presentation-only rotating assembly",
      "gear": "undercarriage structure",
      "wheel": "rolling contact hardware",
      "livery": "paint/decal shells that follow the structure",
      "detail": "small decorative parts"
    }
  },

