{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mosca200/rc-simulation-engine/schemas/golden_scene_manifest.json",
  "title": "Golden Scene Manifest",
  "description": "Machine-readable contract for reproducible visual benchmarks of the RC Simulation Engine renderer.",
  "type": "object",
  "required": [
    "schema_version",
    "scene_id",
    "description",
    "renderer",
    "scenery",
    "camera",
    "resolution",
    "exposure_ev",
    "lighting",
    "sun",
    "aircraft",
    "warmup",
    "capture",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of this schema (e.g., '1.0.0'). Used for forward compatibility."
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 3,
      "maxLength": 128,
      "description": "Unique identifier for this scene. Format: <category>_<scenario>_<variant>. Example: 'aircraft_acro_static_front'."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "description": "Human-readable description of what this scene tests or demonstrates."
    },
    "renderer": {
      "type": "object",
      "required": ["version", "scenery_preset"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "description": "Renderer version or branch identifier. Example: 'integration/render-v2@ec3e17f'."
        },
        "scenery_preset": {
          "type": "string",
          "enum": ["FlyingField", "TestField", "Empty"],
          "description": "Scenery preset to load. Determines terrain, vegetation, atmosphere configuration."
        },
        "vsync": {
          "type": "boolean",
          "default": false,
          "description": "Whether vsync is enabled. Should be false for benchmarking."
        },
        "msaa_samples": {
          "type": "integer",
          "enum": [1, 2, 4, 8],
          "default": 1,
          "description": "MSAA sample count. 1 = no MSAA."
        },
        "taa_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether TAA (Temporal Anti-Aliasing) is enabled."
        },
        "hdr_enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether HDR rendering is enabled."
        }
      },
      "description": "Renderer configuration."
    },
    "scenery": {
      "type": "object",
      "required": ["time_of_day", "weather"],
      "additionalProperties": false,
      "properties": {
        "time_of_day": {
          "type": "string",
          "enum": ["dawn", "morning", "noon", "afternoon", "dusk", "night"],
          "description": "Time of day for lighting and atmosphere."
        },
        "weather": {
          "type": "string",
          "enum": ["clear", "partly_cloudy", "overcast", "fog"],
          "description": "Weather condition."
        },
        "wind_speed_mps": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 0,
          "description": "Wind speed in meters per second. Affects vegetation animation."
        }
      },
      "description": "Scenery environment configuration."
    },
    "camera": {
      "type": "object",
      "required": ["mode", "position", "fov_deg"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["perspective", "orthographic"],
          "description": "Camera projection mode."
        },
        "position": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 3,
          "maxItems": 3,
          "description": "Camera position in render-body frame [x, y, z] in meters. +X right, +Y up, -Z forward."
        },
        "orientation": {
          "type": "object",
          "oneOf": [
            {
              "required": ["quaternion"],
              "additionalProperties": false,
              "properties": {
                "quaternion": {
                  "type": "array",
                  "items": {"type": "number"},
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "Camera orientation as unit quaternion [w, x, y, z]."
                }
              }
            },
            {
              "required": ["look_at"],
              "additionalProperties": false,
              "properties": {
                "look_at": {
                  "type": "array",
                  "items": {"type": "number"},
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Target point to look at in render-body frame [x, y, z] in meters."
                },
                "up": {
                  "type": "array",
                  "items": {"type": "number"},
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [0, 1, 0],
                  "description": "Up vector for camera orientation. Default: [0, 1, 0] (world up)."
                }
              }
            }
          ],
          "description": "Camera orientation. Either quaternion or look_at target."
        },
        "fov_deg": {
          "type": "number",
          "minimum": 10,
          "maximum": 120,
          "description": "Vertical field of view in degrees. Typical: 60 for standard, 90 for wide."
        },
        "near_plane_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.1,
          "description": "Near clipping plane distance in meters."
        },
        "far_plane_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 10000,
          "description": "Far clipping plane distance in meters."
        }
      },
      "description": "Camera configuration."
    },
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 7680,
          "description": "Image width in pixels."
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 4320,
          "description": "Image height in pixels."
        }
      },
      "description": "Output image resolution."
    },
    "exposure_ev": {
      "type": "number",
      "minimum": -10,
      "maximum": 20,
      "description": "Exposure value (EV) in stops. 0 = neutral, +1 = 2x brighter, -1 = 2x darker."
    },
    "lighting": {
      "type": "object",
      "required": ["ambient_intensity", "sun_intensity"],
      "additionalProperties": false,
      "properties": {
        "ambient_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000,
          "description": "Ambient light intensity in lux. Typical outdoor: 10000-25000."
        },
        "sun_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 200000,
          "description": "Sun light intensity in lux. Clear day noon: ~100000."
        },
        "shadow_cascades": {
          "type": "integer",
          "enum": [1, 2, 3, 4],
          "default": 3,
          "description": "Number of shadow map cascades."
        },
        "shadow_resolution": {
          "type": "integer",
          "enum": [512, 1024, 2048, 4096],
          "default": 2048,
          "description": "Shadow map resolution per cascade in pixels."
        }
      },
      "description": "Lighting configuration."
    },
    "sun": {
      "type": "object",
      "oneOf": [
        {
          "required": ["direction"],
          "additionalProperties": false,
          "properties": {
            "direction": {
              "type": "array",
              "items": {"type": "number"},
              "minItems": 3,
              "maxItems": 3,
              "description": "Sun direction as normalized vector [x, y, z] pointing FROM sun TO scene. Render-body frame."
            }
          }
        },
        {
          "required": ["azimuth_deg", "elevation_deg"],
          "additionalProperties": false,
          "properties": {
            "azimuth_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 360,
              "description": "Sun azimuth in degrees. 0 = north, 90 = east, 180 = south, 270 = west."
            },
            "elevation_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "description": "Sun elevation in degrees. 0 = horizon, 90 = zenith."
            }
          }
        }
      ],
      "description": "Sun configuration. Either explicit direction or azimuth/elevation angles."
    },
    "aircraft": {
      "type": "object",
      "required": ["model", "position"],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^models/[a-z0-9_]+/model\\.json$",
          "description": "Path to aircraft model.json relative to repo root. Example: 'models/acro_electric_01/model.json'."
        },
        "position": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 3,
          "maxItems": 3,
          "description": "Aircraft position in render-body frame [x, y, z] in meters."
        },
        "orientation": {
          "type": "object",
          "oneOf": [
            {
              "required": ["quaternion"],
              "additionalProperties": false,
              "properties": {
                "quaternion": {
                  "type": "array",
                  "items": {"type": "number"},
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "Aircraft orientation as unit quaternion [w, x, y, z]."
                }
              }
            },
            {
              "required": ["euler_deg"],
              "additionalProperties": false,
              "properties": {
                "euler_deg": {
                  "type": "array",
                  "items": {"type": "number"},
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Aircraft orientation as Euler angles [roll, pitch, yaw] in degrees."
                }
              }
            }
          ],
          "description": "Aircraft orientation. Either quaternion or Euler angles."
        },
        "throttle": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Engine throttle setting 0.0-1.0."
        },
        "control_state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aileron_deg": {
              "type": "number",
              "minimum": -45,
              "maximum": 45,
              "default": 0,
              "description": "Aileron deflection in degrees. Positive = right roll."
            },
            "elevator_deg": {
              "type": "number",
              "minimum": -45,
              "maximum": 45,
              "default": 0,
              "description": "Elevator deflection in degrees. Positive = pitch up."
            },
            "rudder_deg": {
              "type": "number",
              "minimum": -45,
              "maximum": 45,
              "default": 0,
              "description": "Rudder deflection in degrees. Positive = yaw right."
            }
          },
          "description": "Control surface deflections."
        }
      },
      "description": "Aircraft configuration and pose."
    },
    "warmup": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300,
      "default": 10,
      "description": "Number of frames to render before capture. Allows renderer to stabilize (TAA, shadows, etc.)."
    },
    "capture": {
      "type": "object",
      "required": ["filename", "format"],
      "additionalProperties": false,
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.(png|jpg|exr)$",
          "description": "Output filename. Must match format extension. Example: 'aircraft_acro_static_front.png'."
        },
        "format": {
          "type": "string",
          "enum": ["png", "jpg", "exr"],
          "description": "Image format. PNG = lossless, JPG = lossy, EXR = HDR."
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Specific frame number to capture. If omitted, captures frame after warmup."
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 95,
          "description": "JPEG quality 1-100. Only used when format=jpg."
        }
      },
      "description": "Capture configuration."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "description": "Tags for categorization and filtering. Example: ['aircraft', 'acro', 'static', 'front-view']."
    },
    "reference_hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu": {
          "type": "string",
          "description": "GPU model. Example: 'NVIDIA RTX 4090'."
        },
        "driver_version": {
          "type": "string",
          "description": "GPU driver version. Example: '546.33'."
        },
        "os": {
          "type": "string",
          "description": "Operating system. Example: 'Windows 11 23H2'."
        },
        "notes": {
          "type": "string",
          "description": "Additional notes about reference hardware setup."
        }
      },
      "description": "Reference hardware for which this baseline was validated. Optional but recommended."
    },
    "reference_image": {
      "type": "string",
      "description": "Path to reference image for comparison. Optional. Example: 'baselines/rtx_4090_windows/aircraft_acro_static_front.png'."
    },
    "profiling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_frame_time_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Expected frame time in milliseconds. For performance regression detection."
        },
        "expected_gpu_time_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Expected GPU time in milliseconds."
        }
      },
      "description": "Performance expectations. Optional, for future GPU profiling integration."
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "description": "Number of frames to capture for sequence tests (TAA, animation)."
        },
        "camera_motion": {
          "type": "string",
          "enum": ["static", "orbit", "pan", "zoom"],
          "description": "Camera motion type for sequence."
        },
        "aircraft_motion": {
          "type": "string",
          "enum": ["static", "flyby", "hover", "maneuver"],
          "description": "Aircraft motion type for sequence."
        }
      },
      "description": "Sequence test configuration. Optional, for future TAA sequence tests."
    }
  }
}
