{
  "schema_version": "1.0.0",
  "scene_id": "aircraft_acro_static_front",
  "description": "Canonical reference scene for Acro Electric 01 aircraft in static front view. Tests aircraft rendering, materials, and basic lighting. This is a benchmark contract example, not an approved golden image.",
  "renderer": {
    "version": "v2",
    "terrain_debug": "final",
    "vegetation_debug": "final"
  },
  "scenery": {
    "preset": "flying-field"
  },
  "camera": {
    "mode": "pilot",
    "vertical_fov_deg": 55,
    "pilot_position_render_m": [0.0, 1.8, 20.0]
  },
  "resolution": {
    "width": 1920,
    "height": 1080
  },
  "exposure_ev": 0,
  "aircraft": {
    "model": "models/acro_electric_01/model.json",
    "throttle": 0.0,
    "start_on_ground": true
  },
  "warmup": 10,
  "capture": {
    "filename": "aircraft_acro_static_front_1920x1080.png",
    "format": "png",
    "frame": 10
  },
  "tags": ["aircraft", "acro", "static", "front-view", "benchmark"]
}
